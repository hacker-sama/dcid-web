# PostgreSQL
POSTGRES_URL=jdbc:postgresql://localhost:5432/dcid
POSTGRES_USER=dcid
POSTGRES_PASSWORD=dcid_password

# Keycloak
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/dcid/protocol/openid-connect/certs
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_REALM=dcid

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dcid

# Mail
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_SUBMISSIONS=10

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
