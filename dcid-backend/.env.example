# dcid-backend — biến môi trường (xem application.yml để có danh sách đầy đủ)
# Copy thành .env hoặc export trực tiếp khi chạy `./mvnw spring-boot:run` ngoài docker-compose.
# Trong docker-compose, các giá trị này đã được set sẵn cho service `backend`.

# PostgreSQL — port host 5433 (không phải 5432 mặc định), tránh đụng độ với
# PostgreSQL cài sẵn trên máy dev (xem docker-compose.yml)
POSTGRES_URL=jdbc:postgresql://localhost:5433/dcid
POSTGRES_USER=dcid
POSTGRES_PASSWORD=dcid

# Redis (rate-limit filter — hiện chưa bật ở endpoint nào, không bắt buộc phải chạy)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka (cấu hình sẵn, hiện chưa có @KafkaListener nào dùng tới — không bắt buộc phải chạy)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO (lưu PDF gốc; bucket tự tạo khi upload tài liệu đầu tiên)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kcn-docs

# Self-issued JWT — PHẢI đổi sang chuỗi ngẫu nhiên >= 32 byte khi deploy thật
APP_JWT_SECRET=change-me-dev-secret-please-override-32b+
APP_JWT_EXPIRATION_MS=28800000
APP_JWT_ISSUER=smart-kcn-docs

# Tài khoản admin seed lần đầu (đổi mật khẩu sau khi login lần đầu)
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=admin123

# dcid-ai (xem docs/API-CONTRACT.md) — token phải TRÙNG với AI_INTERNAL_TOKEN của dcid-ai
# 127.0.0.1 (không phải "localhost"): uvicorn mặc định chỉ bind IPv4, dùng "localhost"
# có thể khiến Java thử IPv6 (::1) trước và bị connection refused.
AI_BASE_URL=http://127.0.0.1:8000
AI_INTERNAL_TOKEN=change-me-internal-token

# CORS — origin của frontend (Flutter web). flutter run -d chrome --web-port=3000 khớp mặc định này.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Spring profile: dev (log chi tiết) | prod
SPRING_PROFILES_ACTIVE=dev
