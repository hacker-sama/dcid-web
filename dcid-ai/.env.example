# dcid-ai — biến môi trường (xem docs/PLAN-DCID-AI.md §5)
# Copy thành .env khi chạy local. Trong docker-compose các giá trị được set sẵn.

# PHẢI trùng backend (application.yml: app.ai.internal-token)
AI_INTERNAL_TOKEN=change-me-internal-token

# URL backend Spring Boot (trong compose: http://backend:8080)
BE_BASE_URL=http://localhost:8080

# MinIO — khớp docker-compose.yml (service minio: minio/minio123), KHÔNG phải
# "minioadmin" mặc định của image MinIO.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=kcn-docs
MINIO_SECURE=false

# ChromaDB — service `chroma` trong docker-compose.yml
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── LM Studio (OpenAI-compatible local server) ────────────────────────────────
# Mở LM Studio → nạp model → Start Local Server tại cổng 1234 (mặc định).
#
# Mode A — Chạy LOCAL trực tiếp (không Docker):
#   LM_STUDIO_BASE_URL=http://localhost:1234/v1
#
# Mode B — Chạy trong DOCKER COMPOSE:
#   LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
#   (host.docker.internal tự động trỏ về Host OS trên Docker Desktop Windows/Mac)
#
# LM Studio không cần API key thật — bất kỳ string nào cũng được.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Tên model PHẢI khớp chính xác identifier hiển thị trong LM Studio UI.
# Ví dụ: deepseek-r1-distill-qwen-1.5b, qwen2.5-1.5b-instruct, qwen2.5-7b-instruct
LM_STUDIO_MODEL=deepseek-r1-distill-qwen-1.5b

# Tham số sinh text
LLM_TEMPERATURE=0.1    # thấp = output ổn định, ít hallucinate (khuyến nghị 0.05-0.2)
LLM_MAX_TOKENS=2048    # đủ cho cả chuỗi <think> và câu trả lời kỹ thuật
LLM_TIMEOUT=120.0      # giây — tăng nếu chạy model lớn hoặc model suy luận (DeepSeek-R1) trên CPU

# OCR service (sidecar riêng, port 8001)
OCR_SERVICE_URL=http://localhost:8001
