# dcid-ai — biến môi trường chạy local
# Sao chép thành .env khi chạy ngoài Docker. Docker Compose đã thiết lập sẵn các giá trị tương ứng.

# Phải trùng với backend: app.ai.internal-token
AI_INTERNAL_TOKEN=change-me-internal-token
BE_BASE_URL=http://localhost:8080

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=kcn-docs
MINIO_SECURE=false

# Qdrant vector database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
QDRANT_VECTOR_SIZE=384
QDRANT_VECTORS_ON_DISK=true
QDRANT_HNSW_ON_DISK=true
QDRANT_PAYLOAD_ON_DISK=true

# Ollama OpenAI-compatible API
# Chạy local: http://localhost:11434/v1
# Trong Docker Compose: http://ollama:11434/v1
LM_STUDIO_BASE_URL=http://localhost:11434/v1
LM_STUDIO_API_KEY=ollama
LM_STUDIO_MODEL=qwen2.5:1.5b
VISION_MODEL=qwen2.5vl:3b

# Sinh câu trả lời trong tổng cửa sổ context 4096 token
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_REPETITION_PENALTY=1.2
LLM_CONTEXT_WINDOW=4096
LLM_CONTEXT_SAFETY_TOKENS=256
LLM_MAX_TOKENS=768
LLM_TIMEOUT=300

# OCR sidecar và Celery
OCR_SERVICE_URL=http://localhost:8002
REDIS_URL=redis://localhost:6379/0
AI_RESOURCE_GATE_ENABLED=true
AI_RESOURCE_GATE_FAIL_OPEN=false
AI_RESOURCE_LOCK_WAIT_SECONDS=330
