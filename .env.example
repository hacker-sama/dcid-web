# Copy file này thành .env.production và điền giá trị thật
# KHÔNG commit .env.production vào git!

# PostgreSQL
POSTGRES_PASSWORD=change-me-strong-password

# JWT Secret (>= 32 ký tự)
APP_JWT_SECRET=change-me-32-char-minimum-random-secret

# Bootstrap Admin (đổi sau lần login đầu)
APP_BOOTSTRAP_ADMIN_PASSWORD=Admin@KCN2026!

# MinIO
MINIO_ROOT_PASSWORD=change-me-minio-password

# AI Internal Token (shared secret giữa BE và AI)
AI_INTERNAL_TOKEN=change-me-internal-token

# CORS (domain của web app & app)
CORS_ALLOWED_ORIGINS=https://dcid.tech,https://www.dcid.tech,http://localhost:3000

# LLM Model
LLM_MODEL=qwen2.5:3b
VISION_MODEL=qwen2.5vl:3b
AI_RESOURCE_GATE_ENABLED=true
AI_RESOURCE_GATE_FAIL_OPEN=false
AI_RESOURCE_LOCK_WAIT_SECONDS=330

# Mục tiêu confidence 80%; thấp hơn vẫn trả best-effort kèm cảnh báo
MIN_ANSWER_CONFIDENCE=0.80
